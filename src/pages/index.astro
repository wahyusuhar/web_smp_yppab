---
// Kerangka sementara Fase 1 untuk menguji token & data. Diganti penuh di Fase 4.
import "../styles/global.css";
import Isian from "../components/Isian.astro";
import { sekolah } from "../data/sekolah";
import { saringBaris } from "../lib/isian";

const identitas = saringBaris([
  { label: "Status", nilai: sekolah.status },
  { label: "NPSN", nilai: sekolah.npsn },
  { label: "Akreditasi", nilai: sekolah.akreditasi },
  { label: "Provinsi", nilai: sekolah.alamat.provinsi },
]);
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SMPS YPPAB – SMP Swasta di Jambi</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main class="container-situs section-y">
      <p class="text-eyebrow uppercase text-biru-600">Sedang dibangun</p>
      <h1 class="text-display">{sekolah.nama}</h1>
      <p class="teks-lebar mt-6">{sekolah.ringkasan.teks}</p>
      <dl class="mt-6">
        {
          identitas.map((b) => (
            <div class="flex gap-4">
              <dt class="font-semibold">{b.label}</dt>
              <dd>
                <Isian nilai={b.nilai} />
              </dd>
            </div>
          ))
        }
      </dl>
    </main>
  </body>
</html>
