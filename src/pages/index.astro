---
// Kerangka sementara sampai Fase 4 (beranda penuh).
import BaseLayout from "../layouts/BaseLayout.astro";
import Isian from "../components/Isian.astro";
import Foto from "../components/Foto.astro";
import { sekolah } from "../data/sekolah";
import { saringBaris } from "../lib/isian";
import { judulBeranda } from "../lib/seo";

const identitas = saringBaris([
  { label: "Status", nilai: sekolah.status },
  { label: "NPSN", nilai: sekolah.npsn },
  { label: "Akreditasi", nilai: sekolah.akreditasi },
  { label: "Provinsi", nilai: sekolah.alamat.provinsi },
]);
---

<BaseLayout
  judul={judulBeranda()}
  deskripsi="SMPS YPPAB adalah SMP swasta di Provinsi Jambi untuk kelas 7–9. Lihat profil sekolah, ekstrakurikuler, berita, dan info Penerimaan Murid Baru (SPMB)."
>
  <div class="container-situs section-y">
    <p class="text-eyebrow text-biru-600 uppercase">Sedang dibangun</p>
    <h1 class="text-display">{sekolah.nama}</h1>
    <p class="teks-lebar mt-6">{sekolah.ringkasan.teks}</p>
    <dl class="mt-6">
      {
        identitas.map((b) => (
          <div class="flex gap-4">
            <dt class="font-semibold">{b.label}</dt>
            <dd>
              <Isian nilai={b.nilai} />
            </dd>
          </div>
        ))
      }
    </dl>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <Foto
        src="stok/hero-1"
        alt="Ilustrasi: dua siswa SMP berseragam putih-biru membaca bersama di halaman sekolah"
        rasio="16/9"
        posisi="50% 15%"
        sizes="(min-width: 768px) 50vw, 100vw"
        class="rounded-gambar"
      />
      <Foto src="stok/gedung-1" alt="Placeholder foto gedung sekolah" rasio="16/9" class="rounded-gambar" />
    </div>
  </div>
</BaseLayout>
