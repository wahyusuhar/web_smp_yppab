---
/**
 * Hero halaman dalam: breadcrumb + h1 (+ pengantar) di latar biru-50 dengan garis "dasi" (DESIGN.md §5).
 * Sengaja tanpa foto/slideshow supaya hero beranda tetap istimewa. Dirender oleh BaseLayout lewat prop `h1`.
 */
import Breadcrumb from "./Breadcrumb.astro";
import type { ItemBreadcrumb } from "../lib/schema";

interface Props {
  judul: string;
  pengantar?: string;
  breadcrumb?: ItemBreadcrumb[];
}

const { judul, pengantar, breadcrumb } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-biru-50" aria-labelledby="judul-halaman">
  <!-- Garis "dasi": tiga garis diagonal tipis biru-400 -->
  <svg
    class="absolute inset-y-0 right-0 -z-10 h-full w-1/2 text-biru-400 opacity-50 md:w-1/3"
    viewBox="0 0 300 300"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <line x1="60" y1="0" x2="300" y2="240" stroke="currentColor" stroke-width="1.5"></line>
    <line x1="140" y1="0" x2="300" y2="160" stroke="currentColor" stroke-width="1.5"></line>
    <line x1="220" y1="0" x2="300" y2="80" stroke="currentColor" stroke-width="1.5"></line>
  </svg>
  <div class="container-situs flex flex-col gap-6 pt-6 pb-12 lg:pb-16">
    {breadcrumb && <Breadcrumb item={breadcrumb} />}
    <div class="flex max-w-3xl flex-col gap-4">
      <h1 id="judul-halaman" class="text-h2 font-extrabold">{judul}</h1>
      {pengantar && <p class="teks-lebar">{pengantar}</p>}
      <slot />
    </div>
  </div>
</section>
