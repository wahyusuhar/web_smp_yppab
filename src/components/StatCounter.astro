---
/**
 * Angka statistik (DESIGN.md §5: weight 800, outline biru). Nilai dari sekolah.statistik.
 * `null` → "–" (produksi) / placeholder (dev), dan counter A4 tidak dijalankan (`data-counter` tidak dipasang).
 * Section statistik utuh disembunyikan di produksi bila SEMUA nilai null — tangani dengan `modeElemen()` di section.
 */
import Isian from "./Isian.astro";

interface Props {
  nilai: number | null;
  label: string;
  /** Akhiran, mis. "+" */
  akhiran?: string;
}

const { nilai, label, akhiran = "" } = Astro.props;
---

<div class="flex flex-col gap-2">
  <p class="text-display leading-none font-extrabold text-biru-600">
    {
      nilai === null ? (
        <Isian nilai={null} />
      ) : (
        <>
          <span data-counter={nilai}>{nilai.toLocaleString("id-ID")}</span>
          {akhiran}
        </>
      )
    }
  </p>
  <p class="font-semibold text-biru-800">{label}</p>
</div>
