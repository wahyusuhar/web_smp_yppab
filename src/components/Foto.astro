---
/**
 * Gambar konten (hero, galeri, kegiatan, ekskul, fasilitas, berita).
 * - Foto stok (kredit.ts `stok: true`) → label "Foto ilustrasi" di pojok kiri bawah (DESIGN.md §5).
 * - Placeholder SVG (slot belum berfoto) → dirender apa adanya, tanpa label.
 * Alt foto stok wajib jujur, diawali "Ilustrasi: ..." (ASSETS.md §4).
 */
import { Picture } from "astro:assets";
import { cariFoto } from "../lib/foto";

interface Props {
  /** Path relatif terhadap src/assets/images/, mis. "stok/hero-1" */
  src: string;
  alt: string;
  /** Atribut `sizes`; default lebar penuh viewport */
  sizes?: string;
  /** Rasio tampil CSS, mis. "16/9" atau "4/5". Tanpa ini gambar tampil dengan rasio aslinya. */
  rasio?: string;
  /** `object-position` saat dipotong oleh `rasio`, mis. "50% 15%" */
  posisi?: string;
  /** Hanya untuk gambar LCP (hero). Selain itu lazy. */
  prioritas?: boolean;
  /** Kelas tambahan untuk pembungkus (radius, lebar, dsb.) */
  class?: string;
}

const { src, alt, sizes = "100vw", rasio, posisi, prioritas = false, class: kelas } = Astro.props;
const foto = cariFoto(src);

const LEBAR = [480, 800, 1200, 1600, 2000, 2400];
const lebar =
  foto.jenis === "gambar" ? LEBAR.filter((w) => w <= foto.gambar.width).concat(foto.gambar.width) : [];
const gayaGambar = [rasio && `aspect-ratio: ${rasio}`, posisi && `object-position: ${posisi}`]
  .filter(Boolean)
  .join("; ");
---

<figure class:list={["relative overflow-hidden", kelas]}>
  {
    foto.jenis === "gambar" ? (
      <Picture
        src={foto.gambar}
        alt={alt}
        formats={["avif", "webp"]}
        widths={[...new Set(lebar)]}
        sizes={sizes}
        loading={prioritas ? "eager" : "lazy"}
        fetchpriority={prioritas ? "high" : "auto"}
        decoding={prioritas ? "sync" : "async"}
        class:list={["block h-auto w-full", rasio && "object-cover"]}
        style={gayaGambar || undefined}
      />
    ) : (
      <img
        src={foto.url}
        alt={alt}
        width="1600"
        height="1067"
        loading={prioritas ? "eager" : "lazy"}
        class:list={["block h-auto w-full", rasio && "object-cover"]}
        style={gayaGambar || undefined}
      />
    )
  }
  {
    foto.jenis === "gambar" && foto.stok && (
      <span
        class="pointer-events-none absolute bottom-3 left-3 rounded-full bg-biru-950/75 px-3 py-1 text-xs font-semibold text-putih"
        aria-hidden="true"
      >
        Foto ilustrasi
      </span>
    )
  }
</figure>
