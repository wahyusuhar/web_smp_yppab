---
/** Breadcrumb terlihat (SEO.md §2). JSON-LD BreadcrumbList dibuat BaseLayout dari data yang sama. */
import { ChevronRight } from "@lucide/astro";
import type { ItemBreadcrumb } from "../lib/schema";

interface Props {
  item: ItemBreadcrumb[];
  /** Di atas foto/latar gelap (hero halaman dalam) */
  diLatarGelap?: boolean;
}

const { item, diLatarGelap = false } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class:list={["flex flex-wrap items-center gap-1", diLatarGelap ? "text-biru-100" : "text-abu-700"]}>
    {
      item.map((b, i) => {
        const terakhir = i === item.length - 1;
        return (
          <li class="flex items-center gap-1">
            {terakhir ? (
              <span aria-current="page" class:list={["font-semibold", diLatarGelap ? "text-putih" : "text-biru-800"]}>
                {b.label}
              </span>
            ) : (
              <>
                <a
                  href={b.href}
                  class:list={[
                    "underline-offset-4 hover:underline",
                    diLatarGelap ? "hover:text-putih" : "hover:text-biru-600",
                  ]}
                >
                  {b.label}
                </a>
                <ChevronRight size={16} stroke-width={1.75} />
              </>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
