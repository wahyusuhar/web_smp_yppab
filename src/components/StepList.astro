---
/**
 * Alur langkah bernomor (pendaftaran). Nomor besar weight 800 dengan outline biru (DESIGN.md §5).
 * Konektor `data-konektor` disiapkan untuk A7 (tergambar berurutan) — tanpa JS semuanya tampil penuh.
 */
import type { LangkahAlur } from "../data/sekolah";

interface Props {
  item: LangkahAlur[];
}

const { item } = Astro.props;
---

<ol class="flex flex-col" data-steplist>
  {
    item.map((l, i) => (
      <li class="flex gap-6">
        <div class="flex w-16 shrink-0 flex-col items-center lg:w-20">
          <span class="angka-garis text-h2 leading-none font-extrabold" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
          {i < item.length - 1 && (
            <span class="my-3 w-0.5 flex-1 origin-top bg-biru-400" aria-hidden="true" data-konektor />
          )}
        </div>
        <div class:list={["pt-1", i < item.length - 1 && "pb-10"]}>
          <h3 class="text-h3">
            <span class="sr-only">Langkah {i + 1}: </span>
            {l.judul}
          </h3>
          <p class="teks-lebar mt-2">{l.deskripsi}</p>
        </div>
      </li>
    ))
  }
</ol>
