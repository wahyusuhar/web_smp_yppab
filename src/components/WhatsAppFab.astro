---
/**
 * Tombol WhatsApp melayang (PRD §5, F6, F10; A17).
 * Nomor masih placeholder → dev: kotak placeholder, produksi: tidak dirender. Muncul otomatis saat nomor diisi.
 */
import { MessageCircle } from "@lucide/astro";
import { sekolah } from "../data/sekolah";
import { modeElemen } from "../lib/isian";
import { tautanWhatsApp } from "../lib/whatsapp";

const mode = modeElemen(sekolah.kontak.whatsapp);
const wa = tautanWhatsApp();
---

{
  mode === "tampil" && wa && (
    <a
      href={wa}
      rel="noopener"
      class="efek-angkat fixed right-4 bottom-4 z-30 inline-flex min-h-14 items-center gap-2 rounded-full bg-biru-600 px-4 font-semibold text-putih hover:bg-biru-800 md:right-6 md:bottom-6"
      aria-label="Tanya pendaftaran via WhatsApp"
    >
      <MessageCircle size={24} stroke-width={1.75} />
      <span class="hidden sm:inline">Tanya via WhatsApp</span>
    </a>
  )
}
{
  mode === "placeholder" && (
    <div class="fixed right-4 bottom-4 z-30 max-w-56 rounded-kartu border border-dashed border-abu-300 bg-biru-50 p-3 text-xs text-abu-700 md:right-6 md:bottom-6">
      Tombol WhatsApp muncul setelah <code>kontak.whatsapp</code> diisi di sekolah.ts (placeholder, hanya di dev)
    </div>
  )
}
